# Copy this file to .env for Docker Compose or export these values in your shell.
# Generate a long random SECRET_KEY; do not commit the populated .env file.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production
DATABASE_URL=sqlite:////app/database/agrismart.db
MODEL_PATH=/app/models
LOG_LEVEL=INFO
PORT=5000

# LLM-powered TerraMind AI Assistant (keep this key server-side)
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5.6-sol

# Optional production settings
CORS_ORIGINS=https://your-domain.example
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
LOG_TO_FILE=false
